{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Borderless Studio",
  "version": "0.1.0",
  "identifier": "au.com.borderlesspublishing.studio",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Borderless Studio",
        "width": 1360,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob:; worker-src 'self' blob:; frame-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Write, typeset and export books, fully offline",
    "longDescription": "Borderless Studio is an offline desktop studio for writing, editing, typesetting and exporting books that pass the upload checks of Amazon KDP, IngramSpark and Draft2Digital.",
    "copyright": "Borderless Publishing",
    "publisher": "Borderless Publishing",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/typst"],
    "resources": {
      "../../../resources/": "resources/",
      "../../../specs/": "specs/",
      "bundled-tools/": "tools/"
    },
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-"
    },
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
