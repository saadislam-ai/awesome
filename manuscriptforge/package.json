{
  "name": "manuscriptforge",
  "private": true,
  "version": "0.1.0",
  "description": "Offline book improvement and editing studio for publishers",
  "type": "module",
  "scripts": {
    "pdf-assets": "node scripts/copy-pdf-assets.mjs",
    "predev": "npm run pdf-assets",
    "dev": "vite",
    "prebuild": "npm run pdf-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/ai.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "fixtures": "node tests/fixtures/build-fixtures.mjs",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test:desktop": "node tests/e2e/desktop-smoke.mjs",
    "engine:fetch": "node scripts/fetch-llama.mjs"
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@tauri-apps/api": "^2.12.5",
    "@tiptap/extension-text-align": "^3.35.1",
    "@tiptap/pm": "^3.35.1",
    "@tiptap/react": "^3.35.1",
    "@tiptap/starter-kit": "^3.35.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "domhandler": "^6.0.1",
    "fflate": "^0.8.3",
    "franc-min": "^6.2.0",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^1.82.0",
    "marked": "^18.3.0",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
